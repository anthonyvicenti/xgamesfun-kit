{
  "name": "gamesfun-kit",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "games.fun kit: build multiplayer three.js browser games with Solana items, loot boxes and tokens, using the AI coding agent you already have.",
  "type": "module",
  "bin": {
    "gamesfun": "bin/gamesfun.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:smoke": "node --test --test-concurrency=1 tests/smoke.test.mjs",
    "dev": "node bin/gamesfun.mjs dev",
    "mcp": "node mcp/server.mjs",
    "sync-kits": "node scripts/sync-kits.mjs",
    "sync-skills": "node scripts/sync-skills.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "playwright-core": "1.63.0"
  }
}
