{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://games.fun/schemas/pitch/0.json",
 "title": "games.fun Studio v2 pitch (out/pitch.json)",
 "description": "What a pitch or refine job writes (research/studio-v2/BUILD_JOB.md \u00a72). A pitch job gives 2\u20133 cards; a refine job may narrow to 1. Every card carries a complete game spec (game-spec.schema.json) that assumes each question's default answer. The worker validates this file, and Studio shows it as cards, questions and a reply.",
 "type": "object",
 "required": [
  "pitchVersion",
  "cards",
  "questions",
  "research",
  "policy"
 ],
 "additionalProperties": false,
 "properties": {
  "pitchVersion": {
   "const": 0
  },
  "reply": {
   "type": "string",
   "maxLength": 400,
   "description": "One or two sentences to the creator in the chat: what changed, or what the agent decided once the question budget ran out."
  },
  "cards": {
   "type": "array",
   "minItems": 1,
   "maxItems": 3,
   "items": {
    "type": "object",
    "required": [
     "id",
     "title",
     "hook",
     "howItPlays",
     "players",
     "whyFunny",
     "similar",
     "v1",
     "conceptPrompt",
     "spec"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,23}$",
      "description": "Stable within the conversation, e.g. 'a', 'b', 'c'. A refine keeps an id when it revises that card."
     },
     "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
     },
     "hook": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "One line: why this is fun with friends."
     },
     "howItPlays": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "description": "2\u20133 sentences, plain words."
     },
     "players": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "e.g. '2\u20134 friends; bots fill empty seats'."
     },
     "whyFunny": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
     },
     "similar": {
      "type": "array",
      "maxItems": 4,
      "items": {
       "type": "object",
       "required": [
        "name",
        "why"
       ],
       "additionalProperties": false,
       "properties": {
        "name": {
         "type": "string",
         "minLength": 1,
         "maxLength": 80
        },
        "url": {
         "type": "string",
         "maxLength": 300,
         "pattern": "^https?://"
        },
        "why": {
         "type": "string",
         "minLength": 1,
         "maxLength": 200
        }
       }
      }
     },
     "v1": {
      "type": "object",
      "required": [
       "has",
       "notYet"
      ],
      "additionalProperties": false,
      "properties": {
       "has": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {
         "type": "string",
         "minLength": 1,
         "maxLength": 120
        }
       },
       "notYet": {
        "type": "array",
        "maxItems": 8,
        "items": {
         "type": "string",
         "minLength": 1,
         "maxLength": 120
        }
       }
      }
     },
     "conceptPrompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "description": "A prompt for a concept image of this card (an image model, later)."
     },
     "spec": {
      "$ref": "game-spec.schema.json"
     },
     "fit": {
      "enum": [
       "faithful",
       "variation"
      ],
      "description": "faithful: a faithful take on the game the creator named (its signature loop mapped onto the kit). variation: a different take. Only when the prompt names an existing game."
     }
    }
   }
  },
  "questions": {
   "type": "array",
   "maxItems": 3,
   "description": "At most 3 across the whole conversation (the job's request.json says how many are left). Each applies to whichever card the creator picks.",
   "items": {
    "type": "object",
    "required": [
     "id",
     "text",
     "options",
     "default"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
     },
     "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
     },
     "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
       "type": "object",
       "required": [
        "id",
        "label"
       ],
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        },
        "label": {
         "type": "string",
         "minLength": 1,
         "maxLength": 60
        },
        "set": {
         "type": "object",
         "maxProperties": 8,
         "propertyNames": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9_~/-]{1,120}$"
         },
         "description": "Optional: what picking this option changes in the chosen card's spec, as JSON pointer \u2192 value (e.g. {\"/round/seconds\": 180}). When every picked option has `set` (or is the default) and the creator typed nothing, the worker locks the spec without an agent."
        }
       }
      }
     },
     "default": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
      "description": "The id of the option the cards' specs already assume."
     }
    }
   }
  },
  "research": {
   "type": "object",
   "required": [
    "bank",
    "web",
    "notes"
   ],
   "additionalProperties": false,
   "properties": {
    "bank": {
     "type": "array",
     "maxItems": 20,
     "items": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
     },
     "description": "Research bank entry ids or paths consulted (node research/bank/search.mjs)."
    },
    "web": {
     "type": "array",
     "maxItems": 10,
     "items": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^https?://"
     }
    },
    "notes": {
     "type": "string",
     "maxLength": 1200
    }
   }
  },
  "policy": {
   "type": "object",
   "required": [
    "ok"
   ],
   "additionalProperties": false,
   "properties": {
    "ok": {
     "type": "boolean",
     "description": "true when the cards are within policy (PLAN \u00a77). false only with no cards worth building; then write out/failure.txt instead."
    },
    "steered": {
     "type": "string",
     "maxLength": 400,
     "description": "What was changed to keep it within policy, in words the creator reads."
    }
   }
  }
 }
}
